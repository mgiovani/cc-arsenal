root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
insert_final_newline = true

[*.py]
# ruff owns Python indentation; ec would otherwise flag docstring prose bullets
indent_size = unset

[*.md]
indent_size = 2

[Makefile]
indent_style = tab

[LICENSE.txt]
indent_size = unset
indent_style = unset
