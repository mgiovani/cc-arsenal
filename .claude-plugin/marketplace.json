{
  "$schema": "https://anthropic.com/claude-code/marketplace.schema.json",
  "name": "cc-arsenal-marketplace",
  "owner": {
    "name": "Giovani Moutinho",
    "email": "e@giovani.dev"
  },
  "metadata": {
    "description": "Claude Code Arsenal - Professional commands and skills for development workflows",
    "version": "1.4.0"
  },
  "plugins": [
    {
      "name": "cc-arsenal",
      "source": "./",
      "strict": true,
      "description": "Complete toolkit: all commands (dev, docs, git, claude, jira) and skills (agent-browser, jira-cli, skill-creator, find-skills)",
      "version": "1.4.0",
      "author": {
        "name": "Giovani Moutinho",
        "email": "e@giovani.dev",
        "url": "https://github.com/mgiovani/cc-arsenal"
      },
      "homepage": "https://github.com/mgiovani/cc-arsenal",
      "repository": "https://github.com/mgiovani/cc-arsenal",
      "license": "MIT",
      "keywords": ["productivity", "git", "documentation", "jira", "workflow", "automation", "browser-automation"],
      "category": "productivity"
    },
    {
      "name": "cc-arsenal-dev",
      "source": "./",
      "strict": false,
      "description": "Development commands: feature implementation and bug fixing with test-driven debugging",
      "version": "1.4.0",
      "author": {
        "name": "Giovani Moutinho",
        "email": "e@giovani.dev",
        "url": "https://github.com/mgiovani/cc-arsenal"
      },
      "homepage": "https://github.com/mgiovani/cc-arsenal",
      "repository": "https://github.com/mgiovani/cc-arsenal",
      "license": "MIT",
      "keywords": ["development", "feature", "implementation", "subagents"],
      "category": "development",
      "commands": ["./commands/dev/"]
    },
    {
      "name": "cc-arsenal-docs",
      "source": "./",
      "strict": false,
      "description": "Documentation commands only: ADR, RFC, diagrams, init, check, and update",
      "version": "1.4.0",
      "author": {
        "name": "Giovani Moutinho",
        "email": "e@giovani.dev",
        "url": "https://github.com/mgiovani/cc-arsenal"
      },
      "homepage": "https://github.com/mgiovani/cc-arsenal",
      "repository": "https://github.com/mgiovani/cc-arsenal",
      "license": "MIT",
      "keywords": ["documentation", "adr", "rfc", "diagrams", "architecture"],
      "category": "documentation",
      "commands": [
        "./commands/docs/"
      ]
    },
    {
      "name": "cc-arsenal-git",
      "source": "./",
      "strict": false,
      "description": "Git workflow commands: conventional commits and PR creation",
      "version": "1.4.0",
      "author": {
        "name": "Giovani Moutinho",
        "email": "e@giovani.dev",
        "url": "https://github.com/mgiovani/cc-arsenal"
      },
      "homepage": "https://github.com/mgiovani/cc-arsenal",
      "repository": "https://github.com/mgiovani/cc-arsenal",
      "license": "MIT",
      "keywords": ["git", "commits", "pull-requests", "conventional-commits"],
      "category": "development",
      "commands": [
        "./commands/git/"
      ]
    },
    {
      "name": "cc-arsenal-skills",
      "source": "./",
      "strict": false,
      "description": "Skills only: Browser automation (agent-browser), Jira CLI integration, skill creation guide, and third-party skill discovery (find-skills)",
      "version": "1.4.0",
      "author": {
        "name": "Giovani Moutinho",
        "email": "e@giovani.dev",
        "url": "https://github.com/mgiovani/cc-arsenal"
      },
      "homepage": "https://github.com/mgiovani/cc-arsenal",
      "repository": "https://github.com/mgiovani/cc-arsenal",
      "license": "MIT",
      "keywords": ["skills", "jira", "skill-creator", "browser-automation", "agent-browser", "productivity"],
      "category": "productivity",
      "skills": [
        "./skills/"
      ]
    }
  ]
}
