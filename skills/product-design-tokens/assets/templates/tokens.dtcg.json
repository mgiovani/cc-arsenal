{
  "$description": "Design tokens in W3C DTCG format, pinned to https://www.designtokens.org/tr/2025.10/ (STABLE — never /tr/drafts/). This JSON is the CANONICAL source of truth. Any DESIGN.md prose is a derived, optional, ALPHA layer. Colours use structured sRGB {colorSpace, components}; contrast.py also accepts #hex. Dimensions use {value, unit} with unit px or rem.",
  "color": {
    "$type": "color",
    "base": {
      "$description": "Primitive palette — raw values. UI code references the semantic layer below, not these.",
      "white": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1] } },
      "gray-100": { "$value": { "colorSpace": "srgb", "components": [0.9529, 0.9569, 0.9647] } },
      "gray-600": { "$value": { "colorSpace": "srgb", "components": [0.2941, 0.3333, 0.3882] } },
      "gray-900": { "$value": { "colorSpace": "srgb", "components": [0.0667, 0.0941, 0.1529] } },
      "blue-600": { "$value": { "colorSpace": "srgb", "components": [0.1137, 0.3059, 0.8471] } },
      "red-600": { "$value": { "colorSpace": "srgb", "components": [0.8627, 0.149, 0.149] } },
      "green-600": { "$value": { "colorSpace": "srgb", "components": [0.0863, 0.6392, 0.2902] } }
    },
    "semantic": {
      "$description": "Role tokens — alias the base layer. This is what components consume.",
      "bg-default": { "$value": "{color.base.white}" },
      "surface-muted": { "$value": "{color.base.gray-100}" },
      "text-default": { "$value": "{color.base.gray-900}" },
      "text-muted": { "$value": "{color.base.gray-600}" },
      "primary": { "$value": "{color.base.blue-600}" },
      "text-on-primary": { "$value": "{color.base.white}" },
      "status-error": { "$value": "{color.base.red-600}", "$description": "Never the only channel — pair with icon/text (WCAG 1.4.1)." },
      "status-success": { "$value": "{color.base.green-600}", "$description": "Never the only channel — pair with icon/text (WCAG 1.4.1)." }
    }
  },
  "space": {
    "$type": "dimension",
    "$description": "4px base scale.",
    "0": { "$value": { "value": 0, "unit": "px" } },
    "1": { "$value": { "value": 4, "unit": "px" } },
    "2": { "$value": { "value": 8, "unit": "px" } },
    "3": { "$value": { "value": 12, "unit": "px" } },
    "4": { "$value": { "value": 16, "unit": "px" } },
    "6": { "$value": { "value": 24, "unit": "px" } },
    "8": { "$value": { "value": 32, "unit": "px" } }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": { "value": 4, "unit": "px" } },
    "md": { "$value": { "value": 8, "unit": "px" } },
    "full": { "$value": { "value": 9999, "unit": "px" } }
  },
  "size": {
    "$type": "dimension",
    "$description": "Interactive-target minimum: WCAG 2.2 SC 2.5.8 Target Size (Minimum) is 24x24 CSS px.",
    "target-min": { "$value": { "value": 24, "unit": "px" } }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": ["Inter", "system-ui", "sans-serif"] }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "semibold": { "$value": 600 }
    },
    "size": {
      "$type": "dimension",
      "body": { "$value": { "value": 1, "unit": "rem" } },
      "h1": { "$value": { "value": 2, "unit": "rem" } }
    }
  },
  "$extensions": {
    "org.designtokens.contrast": {
      "$comment": "Consumed by scripts/contrast.py — WCAG 2.2 AA pairs to verify. Add a row per foreground/background pair the UI actually renders.",
      "pairs": [
        { "name": "body text on surface", "fg": "{color.semantic.text-default}", "bg": "{color.semantic.bg-default}", "level": "AA-normal" },
        { "name": "muted text on surface", "fg": "{color.semantic.text-muted}", "bg": "{color.semantic.bg-default}", "level": "AA-normal" },
        { "name": "label on primary button", "fg": "{color.semantic.text-on-primary}", "bg": "{color.semantic.primary}", "level": "AA-normal" }
      ]
    }
  }
}
